<#
  PANEL - Fábrica de Casos
  Genera Panel.html (todo el sistema en una sola página) y lo abre en el navegador.
  Todo local. No instala nada y no sube nada a internet.
  Uso:  powershell -ExecutionPolicy Bypass -File .\panel.ps1
#>
$ErrorActionPreference = 'Stop'
$Base = Split-Path -Parent $MyInvocation.MyCommand.Path
$Salida = Join-Path $Base 'Panel.html'
$inv = [Globalization.CultureInfo]::InvariantCulture

function Esc([string]$s){ [Net.WebUtility]::HtmlEncode($s) }
function FileUri([string]$p){ ([Uri]$p).AbsoluteUri }

function Inline([string]$l){
  $e = Esc $l
  $e = [regex]::Replace($e,'\*\*(.+?)\*\*','<b>$1</b>')
  $e = [regex]::Replace($e,'`([^`]+)`','<code>$1</code>')
  $e = [regex]::Replace($e,'\[([^\]]+)\]\((https?://[^)\s]+)\)','<a href="$2" target="_blank" rel="noopener">$1</a>')
  $e = [regex]::Replace($e,'(?<!["=>])(https?://[^\s<)|]+)','<a href="$1" target="_blank" rel="noopener">enlace</a>')
  return $e
}

# Markdown simple -> HTML (titulos, listas, tablas, negritas, enlaces)
function ConvertirMd([string]$txt){
  $o = New-Object Text.StringBuilder
  $lista = $false; $tabla = $false; $fila0 = $true
  foreach($l in ($txt -split "`r?`n")){
    $esItem = $l -match '^\s*[-*]\s+'
    $esTabla = $l -match '^\s*\|'
    if($lista -and -not $esItem){ [void]$o.Append('</ul>'); $lista = $false }
    if($tabla -and -not $esTabla){ [void]$o.Append('</tbody></table></div>'); $tabla = $false }
    if($esTabla){
      if($l -match '^\s*\|[\s:|-]+\|\s*$'){ continue }
      $celdas = ($l.Trim().Trim('|') -split '\|') | ForEach-Object { Inline $_.Trim() }
      if(-not $tabla){ [void]$o.Append('<div class="tw"><table><thead>'); $tabla = $true; $fila0 = $true }
      if($fila0){ [void]$o.Append('<tr>' + (($celdas | ForEach-Object { "<th>$_</th>" }) -join '') + '</tr></thead><tbody>'); $fila0 = $false }
      else { [void]$o.Append('<tr>' + (($celdas | ForEach-Object { "<td>$_</td>" }) -join '') + '</tr>') }
      continue
    }
    if($esItem){
      if(-not $lista){ [void]$o.Append('<ul>'); $lista = $true }
      [void]$o.Append('<li>' + (Inline ($l -replace '^\s*[-*]\s+','')) + '</li>')
    }
    elseif($l -match '^(#{1,4})\s+(.*)$'){
      $n = [Math]::Min($Matches[1].Length + 2, 6)
      [void]$o.Append("<h$n>" + (Inline $Matches[2]) + "</h$n>")
    }
    elseif($l.Trim() -and $l.Trim() -ne '---'){ [void]$o.Append('<p>' + (Inline $l) + '</p>') }
  }
  if($lista){ [void]$o.Append('</ul>') }
  if($tabla){ [void]$o.Append('</tbody></table></div>') }
  return $o.ToString()
}

# ---- lectura de casos (## N. Titulo, luego lineas "- Etiqueta: texto") ----
function LeerCasos([string]$txt){
  $casos = @(); $cur = $null
  foreach($l in ($txt -split "`r?`n")){
    if($l -match '^##\s+(\d+)\.\s+(.+)$'){
      $cur = @{num=[int]$Matches[1]; nom=$Matches[2]; campos=[ordered]@{}}
      $casos += ,$cur; continue
    }
    if($l -match '^##\s'){ $cur = $null; continue }
    if(-not $cur){ continue }
    if($l -match '^-\s+([^:]{2,40}):\s*(.*)$'){ $cur.campos[$Matches[1].Trim()] = $Matches[2].Trim() }
  }
  return ,$casos
}
function Campo($c,[string]$patron){
  foreach($k in $c.campos.Keys){ if((($k.Normalize([Text.NormalizationForm]::FormD)) -replace '\p{Mn}','') -match $patron){ return $c.campos[$k] } }
  return ''
}
function LeerPuntajes([string]$txt){
  $h = @{}
  foreach($l in ($txt -split "`r?`n")){
    if($l -match '^\|\s*(\d+)\s*\|.*\|\s*\**([\d]+[,.]?[\d]*)\**\s*\|\s*$'){ $h[[int]$Matches[1]] = $Matches[2] }
  }
  return $h
}

# ---- CASOS y RANKING ----
$casosHtml = ''; $rankHtml = ''; $totCasos = 0; $hayRanking = $false; $hayCasos = $false
$ideasDir = Join-Path $Base 'Ideas'
if(Test-Path $ideasDir){
  foreach($f in (Get-ChildItem $ideasDir -Filter 'casos_*.md' | Sort-Object LastWriteTime -Descending)){
    $hayCasos = $true
    $txt = Get-Content $f.FullName -Raw -Encoding UTF8
    $casos = LeerCasos $txt
    $rf = Join-Path $ideasDir ($f.BaseName -replace '^casos_','ranking_casos_' | ForEach-Object { $_ + '.md' })
    $pt = @{}
    if(Test-Path $rf){ $pt = LeerPuntajes (Get-Content $rf -Raw -Encoding UTF8); $hayRanking = $true }
    $casosHtml += "<h3 class='gh'>$(Esc $f.BaseName) <small>$($f.LastWriteTime.ToString('yyyy-MM-dd HH:mm'))</small></h3>"
    if($casos.Count -eq 0){
      $casosHtml += "<details class='idea'><summary><div class='tt'><b>Ver archivo completo</b><small>$(Esc $f.Name)</small></div></summary><div class='body md'>$(ConvertirMd $txt)</div></details>"
      continue
    }
    $totCasos += $casos.Count
    $intro = ($txt -split '(?m)^##\s+\d+\.',2)[0].Trim()
    if($intro.Length -gt 40){ $casosHtml += "<details class='doc'><summary>Patrones que funcionan (la investigación detrás de estos casos)</summary><div class='md'>$(ConvertirMd $intro)</div></details>" }
    $orden = $casos | Sort-Object { if($pt.ContainsKey($_.num)){ -[double]::Parse(($pt[$_.num] -replace ',','.'),$inv) } else { 0 } }, { $_.num }
    $pos = 0
    foreach($c in $orden){
      $pos++
      $sc = ''; $rk = "<span class='rk'>$($c.num)</span>"
      if($pt.ContainsKey($c.num)){ $sc = "<span class='score'>$($pt[$c.num])</span>"; $rk = "<span class='rk r$pos'>$pos</span>" }
      $mat = Campo $c '^Material'
      $nivel = 'x'; $etq = ''
      if($mat -match '^\s*(MUCHO|MEDIO|POCO)'){ $nivel = $Matches[1].ToLower(); $etq = "Material: $($Matches[1].ToLower())" }
      $badge = if($etq){ "<span class='mat $nivel'>$etq</span>" } else { '' }
      $gancho = (Campo $c '^Quien') -replace '^"|"$',''
      if(-not $gancho){ $gancho = (Campo $c '^Frase') -replace '^"|"$','' }
      if($c.nom -ceq $c.nom.ToUpper()){ $low = $c.nom.ToLower(); $c.nom = $low.Substring(0,1).ToUpper() + $low.Substring(1) }
      $btn = "<button class='pick' data-num='$($c.num)' data-nom='$(Esc $c.nom)'>Elegir este</button>"
      $body = ''
      $orde = 'Resumen','Frase-gancho','Giro','Por que conecta','Fuentes','Riesgos','Material libre'
      $usados = @{}
      foreach($k in $c.campos.Keys){
        $kn = ($k.Normalize([Text.NormalizationForm]::FormD)) -replace '\p{Mn}',''
        $clase = 'f'
        if($kn -match '^Frase'){ $clase = 'hook' } elseif($kn -match '^Por que'){ $clase = 'why' } elseif($kn -match '^Riesgo'){ $clase = 'risk' }
        $body += "<div class='$clase'><span>$(Esc $k)</span>$(Inline $c.campos[$k])</div>"
      }
      $casosHtml += "<details class='idea'><summary>$rk<div class='tt'><b>$(Esc $c.nom)</b><small>$(Esc $gancho)</small></div>$badge$sc$btn</summary><div class='body'>$body</div></details>"
    }
  }
  $primero = $true
  foreach($f in (Get-ChildItem $ideasDir -Filter 'ranking_casos_*.md' | Sort-Object LastWriteTime -Descending)){
    $abierto = if($primero){' open'}else{''}; $primero = $false
    $rankHtml += "<details class='doc'$abierto><summary>$(Esc $f.BaseName) <small>$($f.LastWriteTime.ToString('yyyy-MM-dd HH:mm'))</small></summary><div class='md'>$(ConvertirMd (Get-Content $f.FullName -Raw -Encoding UTF8))</div></details>"
  }
}
if(-not $casosHtml){ $casosHtml = '<p class="vacio">Todavía no hay casos. Escribe /producir-caso en Claude Code.</p>' }
if(-not $rankHtml){ $rankHtml = '<p class="vacio">Todavía no hay ranking. Lo hace el analista de viralidad después de los casos.</p>' }

# ---- PROYECTOS ----
$etapas = @(
  @{n='Título y miniatura'; a=@('paquete.md')},
  @{n='Guion v1';           a=@('guion_v1.md')},
  @{n='Verificado';         a=@('guion_v2_verificado.md')},
  @{n='Guion final';        a=@('guion_final.txt')},
  @{n='Escenas';            a=@('escenas.json')},
  @{n='Revisión recursos';  a=@('revision.html')},
  @{n='Papeleo';            a=@('storyboard.csv','subtitulos_estimados.srt','descripcion_y_creditos.txt')},
  @{n='Edición (CapCut)';   a=@('exportar\borrador.mp4')}
)
$proyHtml = ''; $nProy = 0
$flags = @{pq=$false; g1=$false; ver=$false; fin=$false; rec=$false}
$pDir = Join-Path $Base 'Proyectos'
if(Test-Path $pDir){
  foreach($p in (Get-ChildItem $pDir -Directory | Where-Object { $_.Name -notmatch '^(_|Prueba)' })){
    $nProy++
    $chips = ''; $hechas = 0
    foreach($e in $etapas){
      $ok = $true; foreach($a in $e.a){ if(-not (Test-Path (Join-Path $p.FullName $a))){ $ok = $false } }
      if($ok){ $hechas++ }
      $chips += "<span class='chip $(if($ok){'ok'}else{'no'})'>$(if($ok){'&#10003;'}else{'&#9675;'}) $($e.n)</span>"
    }
    if(Test-Path (Join-Path $p.FullName 'paquete.md')){ $flags.pq = $true }
    if(Test-Path (Join-Path $p.FullName 'guion_v1.md')){ $flags.g1 = $true }
    if(Test-Path (Join-Path $p.FullName 'guion_v2_verificado.md')){ $flags.ver = $true }
    if(Test-Path (Join-Path $p.FullName 'guion_final.txt')){ $flags.fin = $true }
    if(Test-Path (Join-Path $p.FullName 'revision.html')){ $flags.rec = $true }
    $pct = [int](100 * $hechas / $etapas.Count)
    $nRec = 0; $rd = Join-Path $p.FullName 'recursos'
    if(Test-Path $rd){ $nRec = @(Get-ChildItem $rd -File -Recurse).Count }
    $links = ''
    foreach($arch in (Get-ChildItem $p.FullName -File | Sort-Object Name)){ $links += "<a class='file' href='$(FileUri $arch.FullName)'>$(Esc $arch.Name)</a>" }
    $rev = Join-Path $p.FullName 'revision.html'
    $btnRev = if(Test-Path $rev){"<a class='btn' href='$(FileUri $rev)'>Abrir revisión</a>"}else{''}
    $hoja = Join-Path $p.FullName 'exportar\hoja_edicion.html'
    $btnHoja = if(Test-Path $hoja){"<a class='btn' href='$(FileUri $hoja)'>Hoja de edición</a>"}else{''}
    $proyHtml += "<section class='card'><div class='top'><h3>$(Esc $p.Name)</h3><span class='pct'>$pct%</span></div><div class='bar'><i style='width:$pct%'></i></div><div class='chips'>$chips</div><p class='meta'>$nRec recursos descargados</p><div class='btns'>$btnRev$btnHoja<a class='btn sec' href='$(FileUri $p.FullName)'>Abrir carpeta</a></div><div class='files'>$links</div></section>"
  }
}
if(-not $proyHtml){ $proyHtml = '<p class="vacio">Todavía no hay videos en producción.</p>' }

# ---- AVANCE (documentos de cada video) ----
$docsAv = @(
  @{f='paquete.md';            n='Títulos y miniaturas';     d='Opciones de título, miniatura, gancho y descripción'},
  @{f='guion_v1.md';           n='Guion v1';                 d='Primer guion del narrador'},
  @{f='verificacion.md';       n='Verificación de datos';    d='Cada dato con su fuente y su estado'},
  @{f='guion_v2_verificado.md';n='Guion verificado (v2)';    d='Guion con los datos corregidos'},
  @{f='cambios_estilo.md';     n='Cambios de estilo';        d='Qué ajustó el editor de estilo'},
  @{f='guion_final.txt';       n='Guion final';              d='Texto listo para grabar'}
)
$avanceHtml = ''; $titulosHtml = ''
if(Test-Path $pDir){
  foreach($p in (Get-ChildItem $pDir -Directory | Where-Object { $_.Name -notmatch '^(_|Prueba)' })){
    $hay = @($docsAv | Where-Object { Test-Path (Join-Path $p.FullName $_.f) })
    $avanceHtml += "<h3 class='gh'>$(Esc $p.Name)</h3>"
    $pq = Join-Path $p.FullName 'paquete.md'
    if(Test-Path $pq){ $titulosHtml += "<h3 class='gh'>$(Esc $p.Name)</h3><div class='md doc2'>$(ConvertirMd (Get-Content $pq -Raw -Encoding UTF8))</div>" }
    if($hay.Count -eq 0){ $avanceHtml += '<p class="vacio">Todavía no hay documentos en este video.</p>'; continue }
    $ultimo = $hay[$hay.Count - 1].f
    foreach($d in $docsAv){
      $ruta = Join-Path $p.FullName $d.f
      if(-not (Test-Path $ruta)){ $avanceHtml += "<div class='pend-doc'><b>$(Esc $d.n)</b><small>Todavía no existe</small></div>"; continue }
      $it = Get-Item $ruta
      $raw = Get-Content $ruta -Raw -Encoding UTF8
      $cuerpo = if($d.f -like '*.txt'){ "<pre class='txt'>$(Esc $raw)</pre>" } else { ConvertirMd $raw }
      $pal = ([regex]::Matches($raw,'\S+')).Count
      $ab = if($d.f -eq $ultimo){' open'}else{''}
      $avanceHtml += "<details class='doc'$ab><summary>$(Esc $d.n) <small>$(Esc $d.d) &middot; $pal palabras &middot; $($it.LastWriteTime.ToString('yyyy-MM-dd HH:mm'))</small></summary><div class='md'>$cuerpo</div></details>"
    }
  }
}
if(-not $avanceHtml){ $avanceHtml = '<p class="vacio">Todavía no hay videos en producción.</p>' }
if(-not $titulosHtml){ $titulosHtml = '<p class="vacio">Todavía no hay títulos. Aparecen cuando eliges un caso y el empaquetador propone títulos y miniaturas.</p>' }

# ---- INICIO: pasos ----
$pasos = @(
  @{n='Casos';             d='Buscar historias con gancho y material libre'; ok=$hayCasos},
  @{n='Ranking';           d='Ver cuáles tienen más probabilidad de funcionar'; ok=$hayRanking},
  @{n='Título y miniatura';d='Elegir el título gancho y la miniatura'; ok=$flags.pq},
  @{n='Guion';             d='Escribir la historia con fuentes'; ok=$flags.g1},
  @{n='Verificación';      d='Comprobar cada dato'; ok=$flags.ver},
  @{n='Estilo';            d='Que suene a ti, no a IA'; ok=$flags.fin},
  @{n='Recursos';          d='Imágenes y videos libres del caso real'; ok=$flags.rec}
)
$actual = -1; for($k=0; $k -lt $pasos.Count; $k++){ if(-not $pasos[$k].ok){ $actual = $k; break } }
$hayProy = $nProy -gt 0
$siguiente = switch($actual){
  0 { 'Falta buscar casos. En Claude Code escribe <b>/producir-caso</b>.' }
  1 { 'Falta el ranking de viralidad. Después te toca elegir el caso.' }
  2 { if($hayProy){ '<b>Eligiendo título y miniatura.</b>' } else { '<b>Parada: te toca a ti.</b> Mira la pestaña Casos, pulsa «Elegir este», pega el mensaje en el chat y con eso el empaquetador propone títulos y miniaturas.' } }
  3 { 'Falta el guion. Cuando termine, el siguiente paso es la verificación de datos.' }
  4 { 'Falta la verificación del guion. Después revisas lo que se corrigió.' }
  5 { 'Falta el editor de estilo. Después lees y apruebas el guion final.' }
  6 { 'Falta buscar los recursos. Después revisas revision.html.' }
  default { 'Flujo completo. Sigue el papeleo, grabar tu voz y <b>edicion.ps1</b> para CapCut.' }
}
$pasosHechos = @($pasos | Where-Object { $_.ok }).Count
$pctNivel = [int](100 * $pasosHechos / $pasos.Count)
$mapa = ''
for($k=0; $k -lt $pasos.Count; $k++){
  $m = $pasos[$k]
  if($m.ok){ $cls='hecha'; $est='Listo'; $extra=''; $mark='&#10003;' }
  elseif($k -eq $actual){ $cls='actual'; $est='En curso'; $extra="<div class='tu'>$siguiente</div>"; $mark="$($k+1)" }
  else { $cls='pend'; $est='Pendiente'; $extra=''; $mark="$($k+1)" }
  $mapa += "<div class='paso $cls'><div class='mk'>$mark</div><div class='pt'><b>$($m.n)</b><span>$($m.d)</span>$extra</div><div class='est'>$est</div></div>"
}
$fecha = Get-Date -Format 'yyyy-MM-dd HH:mm'
$cCasos = (Get-ChildItem $ideasDir -Filter 'casos_*.md' -ErrorAction SilentlyContinue | Measure-Object).Count

$html = @"
<!doctype html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Fábrica de Casos</title>
<style>
:root{--bg:#140f1f;--card:#1f1830;--card2:#2a2142;--bd:#3a2f58;--tx:#efeaf8;--mut:#a79ac2;--ac:#f5a524;--ok:#34c38f;--warn:#e8a838;--bad:#ef6b6b}
*{box-sizing:border-box}html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--tx);font:16px/1.6 system-ui,'Segoe UI',sans-serif}
a{color:var(--ac)}
header{position:sticky;top:0;z-index:5;background:rgba(20,15,31,.94);backdrop-filter:blur(8px);border-bottom:1px solid var(--bd)}
.hb{max-width:1000px;margin:auto;padding:0 20px;display:flex;gap:28px;align-items:center;flex-wrap:wrap}
.logo{font-weight:700;font-size:1.1rem;padding:16px 0;letter-spacing:.2px}.logo span{color:var(--ac)}
.tabs{display:flex;gap:4px}
.tabs button{background:none;border:0;border-bottom:2px solid transparent;color:var(--mut);font:inherit;font-weight:600;padding:18px 14px 16px;cursor:pointer}
.tabs button:hover{color:var(--tx)}.tabs button.on{color:var(--tx);border-bottom-color:var(--ac)}
.tabs .n{background:var(--card2);border-radius:99px;padding:0 8px;font-size:.75rem;margin-left:6px;color:var(--mut)}
main{max-width:1000px;margin:auto;padding:30px 20px 80px}
h1{font-size:1.7rem;margin:0 0 6px;font-weight:700}.lead{color:var(--mut);margin:0 0 26px;max-width:640px}
.tab{display:none}.tab.on{display:block;animation:in .25s}@keyframes in{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
.resumen{background:var(--card);border:1px solid var(--bd);border-radius:14px;padding:18px 20px;margin-bottom:22px}
.resumen b{font-size:1.05rem}.resumen small{color:var(--mut);display:block;margin-top:2px}
.prog{height:8px;background:var(--bg);border-radius:6px;margin-top:12px;overflow:hidden}.prog i{display:block;height:100%;background:var(--ok);border-radius:6px}
.pasos{display:flex;flex-direction:column;gap:10px}
.paso{display:flex;gap:16px;align-items:center;background:var(--card);border:1px solid var(--bd);border-radius:14px;padding:14px 18px}
.mk{flex:none;width:36px;height:36px;border-radius:50%;display:grid;place-items:center;font-weight:700;background:var(--card2);color:var(--mut);border:1px solid var(--bd)}
.pt{flex:1;min-width:0}.pt b{display:block}.pt span{color:var(--mut);font-size:.9rem}
.est{flex:none;font-size:.8rem;font-weight:600;color:var(--mut)}
.paso.hecha .mk{background:var(--ok);border-color:var(--ok);color:#06251a}.paso.hecha .est{color:var(--ok)}
.paso.actual{border-color:var(--ac);background:var(--card2)}.paso.actual .mk{background:var(--ac);border-color:var(--ac);color:#2a1a00}.paso.actual .est{color:var(--ac)}
.tu{margin-top:10px;background:var(--bg);border:1px solid var(--bd);border-radius:10px;padding:10px 14px;font-size:.94rem;color:var(--tx)}
.tu b{display:inline}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-top:22px}
.stat{background:var(--card);border:1px solid var(--bd);border-radius:14px;padding:14px 16px}.stat b{font-size:1.7rem;display:block;line-height:1.2}.stat span{color:var(--mut);font-size:.85rem}
.gh{margin:28px 0 12px;font-size:.95rem;color:var(--mut);font-weight:600;text-transform:uppercase;letter-spacing:.06em}.gh small{font-weight:400;margin-left:8px;text-transform:none;letter-spacing:0}
details.idea{background:var(--card);border:1px solid var(--bd);border-radius:14px;margin-bottom:10px;overflow:hidden}
details.idea>summary{list-style:none;cursor:pointer;display:flex;gap:12px;align-items:center;padding:14px 18px}
details.idea>summary::-webkit-details-marker{display:none}details.idea>summary:hover{background:var(--card2)}
details.idea[open]>summary{background:var(--card2);border-bottom:1px solid var(--bd)}
.rk{flex:none;width:34px;height:34px;border-radius:10px;background:var(--bg);display:grid;place-items:center;font-weight:700;color:var(--mut);border:1px solid var(--bd);font-size:.9rem}
.rk.r1,.rk.r2,.rk.r3{background:var(--ac);color:#2a1a00;border-color:var(--ac)}
.tt{flex:1;min-width:0}.tt b{display:block}.tt small{display:block;color:var(--mut);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.score{flex:none;font-weight:700;color:var(--ok);background:rgba(52,195,143,.12);padding:3px 11px;border-radius:99px;font-size:.92rem}
.mat{flex:none;font-size:.72rem;font-weight:700;padding:2px 10px;border-radius:99px;border:1px solid var(--bd);color:var(--mut);white-space:nowrap}
.mat.mucho{color:var(--ok);border-color:rgba(52,195,143,.5);background:rgba(52,195,143,.08)}.mat.medio{color:var(--warn);border-color:rgba(232,168,56,.5);background:rgba(232,168,56,.08)}.mat.poco{color:var(--bad);border-color:rgba(239,107,107,.5);background:rgba(239,107,107,.08)}
.body{padding:18px}
.f,.hook,.why,.risk{border-radius:10px;padding:11px 15px;margin-bottom:10px;font-size:.93rem;border-left:3px solid var(--bd);background:var(--bg)}
.hook{background:rgba(245,165,36,.08);border-color:var(--ac)}.why{background:rgba(52,195,143,.08);border-color:var(--ok)}.risk{background:rgba(232,168,56,.09);border-color:var(--warn)}
.f span,.hook span,.why span,.risk span{display:block;font-size:.7rem;text-transform:uppercase;letter-spacing:.08em;font-weight:700;color:var(--mut);margin-bottom:2px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(310px,1fr));gap:14px}
.card{background:var(--card);border:1px solid var(--bd);border-radius:14px;padding:18px}
.top{display:flex;justify-content:space-between;align-items:center}.top h3{margin:0;font-size:1.05rem}.pct{font-weight:700;color:var(--ok)}
.bar{height:6px;background:var(--bg);border-radius:6px;margin:12px 0;overflow:hidden}.bar i{display:block;height:100%;background:var(--ok);border-radius:6px}
.chips{display:flex;flex-wrap:wrap;gap:6px}.chip{font-size:.76rem;padding:2px 10px;border-radius:99px;border:1px solid var(--bd);color:var(--mut)}.chip.ok{color:var(--ok);border-color:rgba(52,195,143,.5);background:rgba(52,195,143,.08)}
.meta{color:var(--mut);font-size:.85rem;margin:12px 0 6px}.btns{display:flex;gap:8px;margin:8px 0;flex-wrap:wrap}
.btn{background:var(--ac);color:#2a1a00;text-decoration:none;padding:7px 14px;border-radius:9px;font-weight:600;font-size:.88rem}.btn.sec{background:transparent;color:var(--tx);border:1px solid var(--bd)}
.files{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px}.file{font-size:.76rem;color:var(--mut);background:var(--bg);border:1px solid var(--bd);padding:2px 8px;border-radius:7px;text-decoration:none}
details.doc{background:var(--card);border:1px solid var(--bd);border-radius:14px;margin-bottom:12px;padding:2px 20px}
details.doc>summary{cursor:pointer;padding:14px 0;font-weight:600}summary small{color:var(--mut);font-weight:400;margin-left:8px}
.md{padding-bottom:16px;overflow-wrap:anywhere;font-size:.94rem}.md h3,.md h4,.md h5{margin:20px 0 6px}.md code{background:var(--bg);padding:1px 6px;border-radius:6px;font-size:.88em}
.doc2{background:var(--card);border:1px solid var(--bd);border-radius:14px;padding:6px 20px 16px}
.tw{overflow-x:auto;margin:10px 0}table{border-collapse:collapse;width:100%;font-size:.85rem}th,td{border:1px solid var(--bd);padding:7px 10px;text-align:left}th{background:var(--card2)}
.vacio{color:var(--mut)}
.txt{white-space:pre-wrap;font:inherit;line-height:1.7;margin:0}
.pend-doc{background:var(--card);border:1px dashed var(--bd);border-radius:14px;padding:12px 20px;margin-bottom:12px;color:var(--mut)}.pend-doc small{margin-left:8px}
.pick{flex:none;background:var(--ac);color:#2a1a00;border:0;border-radius:9px;padding:7px 14px;font:inherit;font-weight:700;font-size:.85rem;cursor:pointer}.pick:hover{filter:brightness(1.1)}
.src{font-size:.7rem;color:var(--ac);text-decoration:none;border:1px solid var(--ac);border-radius:6px;padding:0 6px;margin-left:2px}
#toast{position:fixed;left:50%;bottom:28px;transform:translateX(-50%) translateY(20px);background:var(--ok);color:#06251a;font-weight:700;padding:12px 20px;border-radius:12px;opacity:0;pointer-events:none;transition:.25s;z-index:20;max-width:90vw;text-align:center}
#toast.on{opacity:1;transform:translateX(-50%)}
@media (max-width:640px){.hb{padding:0 12px;gap:0}.logo{width:100%;padding:12px 0 0}.tabs{width:100%;overflow-x:auto}.tabs button{padding:12px 10px}main{padding:22px 14px 60px}.paso{flex-wrap:wrap}.tt small{white-space:normal}details.idea>summary{flex-wrap:wrap}}
</style></head><body>
<header><div class="hb">
  <div class="logo">F&aacute;brica de <span>Casos</span></div>
  <div class="tabs">
    <button data-tab="inicio" class="on">Inicio</button>
    <button data-tab="casos">Casos <span class="n">$totCasos</span></button>
    <button data-tab="ranking">Ranking</button>
    <button data-tab="titulos">T&iacute;tulos</button>
    <button data-tab="avance">Avance</button>
    <button data-tab="videos">Videos <span class="n">$nProy</span></button>
  </div>
</div></header>
<main>
<section class="tab on" id="t-inicio">
  <h1>Inicio</h1><p class="lead">En qué paso va tu producción y qué sigue.</p>
  <div class="resumen"><b>$pasosHechos de $($pasos.Count) pasos completados</b><small>Panel actualizado: $fecha</small><div class="prog"><i style="width:$pctNivel%"></i></div></div>
  <div class="pasos">$mapa</div>
  <div class="stats">
    <div class="stat"><b>$cCasos</b><span>listas de casos</span></div>
    <div class="stat"><b>$totCasos</b><span>casos con detalle</span></div>
    <div class="stat"><b>$nProy</b><span>videos en carpeta</span></div>
  </div>
</section>
<section class="tab" id="t-casos"><h1>Casos</h1><p class="lead">Toca uno para ver el gancho, el giro, las fuentes, los riesgos y cuánto material libre hay. La etiqueta de color indica el material visual disponible.</p>$casosHtml</section>
<section class="tab" id="t-ranking"><h1>Ranking</h1><p class="lead">Estimaciones de qué caso tiene más posibilidades. No son promesas de visitas.</p>$rankHtml</section>
<section class="tab" id="t-titulos"><h1>T&iacute;tulos y miniaturas</h1><p class="lead">Las opciones de título, miniatura, gancho y descripción de cada video.</p>$titulosHtml</section>
<section class="tab" id="t-avance"><h1>Avance</h1><p class="lead">Lo que se va escribiendo de tu video, en orden. El más reciente aparece abierto.</p>$avanceHtml</section>
<section class="tab" id="t-videos"><h1>Videos</h1><p class="lead">Avance de cada video por etapas.</p><div class="grid">$proyHtml</div></section>
</main>
<div id="toast"></div>
<script>
(function(){
  var bs=document.querySelectorAll('.tabs button'),ts=document.querySelectorAll('.tab');
  function ir(n){
    bs.forEach(function(b){b.classList.toggle('on',b.dataset.tab===n)});
    ts.forEach(function(t){t.classList.toggle('on',t.id==='t-'+n)});
    try{history.replaceState(null,'','#'+n)}catch(e){}
    window.scrollTo(0,0);
  }
  bs.forEach(function(b){b.addEventListener('click',function(){ir(b.dataset.tab)})});
  var h=(location.hash||'').slice(1);
  if(h&&document.getElementById('t-'+h))ir(h);
  var toast=document.getElementById('toast'),tm=null;
  function avisa(t){toast.textContent=t;toast.classList.add('on');clearTimeout(tm);tm=setTimeout(function(){toast.classList.remove('on')},6000)}
  function copia(t){
    if(navigator.clipboard&&window.isSecureContext){return navigator.clipboard.writeText(t)}
    return new Promise(function(ok,no){
      var a=document.createElement('textarea');a.value=t;a.style.position='fixed';a.style.opacity='0';document.body.appendChild(a);a.select();
      try{document.execCommand('copy')?ok():no()}catch(e){no()}document.body.removeChild(a);
    });
  }
  document.querySelectorAll('.pick').forEach(function(b){
    b.addEventListener('click',function(e){
      e.preventDefault();e.stopPropagation();
      var msg='Elijo el caso '+b.dataset.num+': '+b.dataset.nom+'.';
      copia(msg).then(function(){avisa('Copiado. Pégalo en el chat de Claude y envíalo.')})
        .catch(function(){window.prompt('Copia este mensaje y pégalo en el chat:',msg)});
    });
  });
})();
</script>
</body></html>
"@
[IO.File]::WriteAllText($Salida, $html, (New-Object Text.UTF8Encoding($true)))
Write-Host "Listo: $Salida"
Start-Process $Salida
